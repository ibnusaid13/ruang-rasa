# ====== Ruang Rasa — salin/ubah di file .env project Anda (Laragon) ======
APP_NAME="Ruang Rasa"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://ruang-rasa.test        # atau http://127.0.0.1:8000 jika pakai php artisan serve
APP_LOCALE=id

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ruang_rasa
DB_USERNAME=root
DB_PASSWORD=                          # default Laragon: kosong

SESSION_DRIVER=file                   # keranjang TIDAK bergantung pada session, hanya cookie token
FILESYSTEM_DISK=local

# --- Info usaha (bisa juga diubah di /admin/settings) ---
SHOP_ADDRESS=""
SHOP_PHONE=""
SHOP_DELIVERY_FEE=10000               # tarif DEMO, bukan tarif bisnis nyata

# --- Metode pembayaran ---
PAY_BANK_ENABLED=true
PAY_QRIS_ENABLED=false                # true hanya jika sudah upload QRIS RESMI di /admin/settings
PAY_COD_ENABLED=true
PAY_GATEWAY_ENABLED=false             # butuh adapter provider nyata, lihat README

# --- Payment gateway (opsional; HANYA di .env, jangan di Blade/JS) ---
PAYMENT_WEBHOOK_SECRET=
PAYMENT_GATEWAY_CHECKOUT_URL=
